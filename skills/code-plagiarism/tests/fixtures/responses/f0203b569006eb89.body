&lt;= 100; i++ {\n        print(&lt;-tasks)\n    }\n}\n\nfunc GetTask(id int, tasks chan&lt;- string) {\n    res, err := http.Get(&quot;https://<span class=\"highlight\">jsonplaceholder.typicode.com</span> &hellip; ","title":"Access HTTP response as string in Go"}],"has_more":true,"quota_max":300,"quota_remaining":261}